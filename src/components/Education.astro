---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { education } from '@/data';
import Section from '@/components/ui/Section.astro';

// Logos live in src/assets so the Image component can optimise them.
const logos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/logos/*.png', { eager: true });

// Previously hardcoded in the component rather than held in content.
const learningApproach = {
  title: 'Learning and development',
  philosophy:
    'I value strong engineering fundamentals alongside continuous learning, and I bring current tools, most recently AI-assisted development, into practical work that keeps products maintainable, performant, and focused on the people who use them.',
  focusAreas: [
    { area: 'AI Integration', icon: 'lucide:sparkles', description: 'Two kinds of AI work: AI-assisted development workflows and harnesses that speed up delivery, and AI-powered features that bring intelligent, adaptive experiences into the apps themselves.' },
    { area: 'Mobile Architecture', icon: 'lucide:smartphone', description: 'Native Android on clean, modular architecture with offline-first data and a performant UI, built to scale and stay maintainable as products grow.' },
    { area: 'System Design', icon: 'lucide:gauge', description: 'Scalable architecture and reliable performance under real-world load.' },
  ],
};
---

<Section id="education" eyebrow="Learning" title={education.title} description={education.subtitle}>
  <dl class="border-t border-border">
    {education.education.map((item) => (
      <div class="grid gap-x-10 gap-y-3 border-b border-border py-6 md:grid-cols-[minmax(0,180px)_1fr]">
        <dt class="text-sm text-muted-foreground md:pt-0.5">{item.period}</dt>
        <dd>
          <div class="flex items-center gap-3">
            <Image
              class="h-7 w-7 flex-none rounded-md border border-border bg-white object-contain p-1"
              src={logos[`/src/assets/logos/${item.logo}.png`].default}
              alt={`${item.institution} logo`}
              width={56}
              height={56}
              loading="lazy"
              decoding="async"
            />
            <h3 class="font-semibold text-foreground">{item.degree}</h3>
          </div>
          <div class="mt-2 flex items-center gap-2">
            <p class="text-sm text-muted-foreground">{item.institution}</p>
            {item.website && (
              <a
                href={item.website}
                target="_blank"
                rel="noopener noreferrer"
                class="text-muted-foreground transition-colors hover:text-foreground"
                aria-label={`Visit the ${item.institution} website`}
              >
                <Icon name="lucide:external-link" class="h-3.5 w-3.5" />
              </a>
            )}
          </div>
          {item.skills && item.skills.length > 0 && (
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{item.skills.join(' · ')}</p>
          )}
        </dd>
      </div>
    ))}
  </dl>

  <div class="mt-16 rounded-2xl border border-border bg-muted/30 p-6 sm:p-8 md:p-10">
    <div class="flex items-center gap-3">
      <span class="flex h-9 w-9 flex-none items-center justify-center rounded-lg border border-border bg-background text-foreground shadow-sm">
        <Icon name="lucide:graduation-cap" class="h-4 w-4" />
      </span>
      <div class="flex items-center gap-3">
        <span class="h-px w-6 bg-border"></span>
        <span class="font-mono text-xs uppercase tracking-widest text-muted-foreground">Approach</span>
      </div>
    </div>
    <h3 class="mt-4 text-2xl font-semibold tracking-tight text-foreground">{learningApproach.title}</h3>
    <p class="mt-3 max-w-3xl text-base leading-relaxed text-muted-foreground">{learningApproach.philosophy}</p>
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {learningApproach.focusAreas.map((area) => (
        <div class="group rounded-xl border border-border bg-background p-5 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-foreground/20 hover:shadow-md">
          <span class="flex h-10 w-10 items-center justify-center rounded-lg border border-border bg-background text-foreground shadow-sm transition-shadow group-hover:shadow-md">
            <Icon name={area.icon} class="h-5 w-5" />
          </span>
          <h4 class="mt-4 font-semibold text-foreground">{area.area}</h4>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{area.description}</p>
        </div>
      ))}
    </div>
  </div>
</Section>
