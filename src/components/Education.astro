---
import { Icon } from 'astro-icon/components';
import { education } from '@/data';
import Section from '@/components/ui/Section.astro';

// Previously hardcoded in the component rather than held in content.
const learningApproach = {
  title: 'Learning and development',
  philosophy:
    'I place equal value on strong engineering fundamentals and continuous learning. I keep current with new tools and approaches, most recently AI assisted development, and apply them in practical ways that keep products maintainable, performant, and focused on the people who use them.',
  focusAreas: [
    { area: 'AI Integration', description: 'Building and refining AI harnesses and AI assisted workflows that accelerate delivery and bring intelligent, adaptive experiences to mobile apps.' },
    { area: 'Mobile Architecture', description: 'Deep native Android work, with clean modular architecture, offline first data, and a performant UI built to scale and stay maintainable as products grow.' },
    { area: 'System Design', description: 'Scalable architecture and reliable performance under real world load.' },
  ],
};
---

<Section id="education" eyebrow="Learning" title={education.title} description={education.subtitle}>
  <dl class="border-t border-border">
    {education.education.map((item) => (
      <div class="grid gap-x-10 gap-y-3 border-b border-border py-6 md:grid-cols-[minmax(0,180px)_1fr]">
        <dt class="text-sm text-muted-foreground md:pt-0.5">{item.period}</dt>
        <dd>
          <div class="flex items-center gap-3">
            <img
              class="h-7 w-7 flex-none rounded-md border border-border bg-white object-contain p-1"
              src={`/images/logos/${item.logo}.png`}
              alt={`${item.institution} logo`}
              loading="lazy"
              decoding="async"
            />
            <h3 class="font-semibold text-foreground">{item.degree}</h3>
          </div>
          <div class="mt-2 flex items-center gap-2">
            <p class="text-sm text-muted-foreground">{item.institution}</p>
            {item.website && (
              <a
                href={item.website}
                target="_blank"
                rel="noopener noreferrer"
                class="text-muted-foreground transition-colors hover:text-foreground"
                aria-label={`Visit the ${item.institution} website`}
              >
                <Icon name="lucide:external-link" class="h-3.5 w-3.5" />
              </a>
            )}
          </div>
          {item.skills && item.skills.length > 0 && (
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{item.skills.join(' · ')}</p>
          )}
        </dd>
      </div>
    ))}
  </dl>

  <div class="mt-16">
    <h3 class="mb-6 text-xs font-medium uppercase tracking-widest text-muted-foreground">{learningApproach.title}</h3>
    <p class="max-w-3xl text-base leading-relaxed text-muted-foreground">{learningApproach.philosophy}</p>
    <div class="mt-10 grid gap-x-10 gap-y-8 md:grid-cols-3">
      {learningApproach.focusAreas.map((area) => (
        <div>
          <h4 class="font-medium text-foreground">{area.area}</h4>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{area.description}</p>
        </div>
      ))}
    </div>
  </div>
</Section>
