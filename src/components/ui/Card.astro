---
// shadcn/ui Card container. Solid border + card background, no fractional
// opacity. Sub-parts (CardHeader/CardTitle/CardDescription/CardContent) are
// optional; sections may also drop raw markup inside.
interface Props {
  class?: string;
  [key: string]: unknown;
}
const { class: className, ...rest } = Astro.props;
---

<div class:list={['rounded-xl border bg-card text-card-foreground shadow-sm', className]} {...rest}>
  <slot />
</div>
