---
import { Icon } from 'astro-icon/components';
import { projects } from '@/data';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';

// Flattened once at build time. Each project carries the short English sector
// label of its category, so the grid reads to an international audience.
const SECTOR: Record<string, string> = {
  finance: 'Finance & Business',
  academic: 'Academic Research',
};

const allProjects = projects.projectCategories.flatMap((c) =>
  (c.projects ?? []).map((p) => ({ ...p, categoryTitle: c.title }))
);

// 12 keeps the initial view a clean grid at every breakpoint (2, 3, and 4
// columns), and the full 32 divides evenly into the mobile 4-column icon grid.
const INITIAL = 12;
const total = allProjects.length;
---

<Section id="projects" eyebrow="Portfolio" title={projects.title} description={projects.subtitle}>
  <div data-projects-grid class="grid grid-cols-4 gap-2 sm:grid-cols-2 sm:gap-3 lg:grid-cols-3">
    {allProjects.map((project, i) => {
      const closed = project.status === 'discontinued';
      return (
        <button
          type="button"
          hidden={i >= INITIAL}
          data-project-card
          class="group flex aspect-square items-center justify-center rounded-xl border border-border bg-card p-2 text-left transition-all duration-200 hover:-translate-y-0.5 hover:border-foreground/20 hover:shadow-md focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring sm:aspect-auto sm:justify-start sm:gap-4 sm:p-3"
          data-project={JSON.stringify({
            name: project.name,
            description: project.description,
            category: SECTOR[project.category] ?? project.categoryTitle,
            technologies: project.technologies ?? [],
            link: project.link,
            image: project.image,
            fallback: '/images/placeholder.svg',
            status: project.status ?? null,
          })}
        >
          {/* Icons are served locally (downloaded from the store CDN) so they no
              longer depend on a remote host that can block or expire; the onerror
              fallback covers the few without artwork. width/height avoid CLS. */}
          <img
            src={project.image}
            data-fallback="/images/placeholder.svg"
            alt={project.name}
            width="48"
            height="48"
            loading="lazy"
            decoding="async"
            class:list={[
              'h-11 w-11 flex-none rounded-lg border border-border bg-white object-cover sm:h-12 sm:w-12',
              closed && 'opacity-60 grayscale',
            ]}
          />
          <div class="hidden min-w-0 flex-1 sm:block">
            <div class="truncate text-sm font-medium text-foreground">{project.name}</div>
            <div class="mt-0.5 flex items-center gap-2">
              <span class="truncate text-xs text-muted-foreground">{SECTOR[project.category] ?? project.categoryTitle}</span>
              {closed && (
                <span class="flex-none rounded bg-muted px-1.5 py-0.5 text-[10px] font-medium uppercase tracking-wide text-muted-foreground">Discontinued</span>
              )}
            </div>
          </div>
          <Icon name="lucide:arrow-up-right" class="hidden h-4 w-4 flex-none text-muted-foreground opacity-0 transition-opacity group-hover:opacity-100 sm:block" />
        </button>
      );
    })}
  </div>

  {total > INITIAL && (
    <div class="mt-8 flex justify-center">
      <Button variant="outline" data-projects-toggle data-expanded="false">
        <span data-toggle-label>{`Show all ${total} projects`}</span>
        <Icon name="lucide:chevron-down" class="h-4 w-4 transition-transform" data-toggle-icon />
      </Button>
    </div>
  )}
</Section>

{/* Project detail modal */}
<div
  id="project-modal"
  hidden
  class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-4 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-labelledby="project-modal-title"
>
  <div class="relative max-h-[85vh] w-full max-w-lg overflow-y-auto rounded-xl border border-border bg-card text-card-foreground shadow-lg" data-modal-panel>
    <button
      type="button"
      data-modal-close
      aria-label="Close project details"
      class="absolute right-4 top-4 inline-flex h-8 w-8 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
    >
      <Icon name="lucide:x" class="h-4 w-4" />
    </button>

    <div class="p-6">
      <div class="flex items-start gap-4">
        <img data-modal-image alt="" class="h-16 w-16 flex-none rounded-lg border border-border bg-white object-cover" />
        <div class="min-w-0 pr-8">
          <h3 id="project-modal-title" data-modal-name class="text-lg font-semibold leading-tight text-foreground"></h3>
          <div class="mt-2 flex flex-wrap items-center gap-2">
            <Badge variant="secondary" data-modal-category></Badge>
            <span
              data-modal-status
              hidden
              class="rounded bg-muted px-2 py-0.5 text-xs font-medium uppercase tracking-wide text-muted-foreground"
            >Discontinued</span>
          </div>
        </div>
      </div>

      <p data-modal-description class="mt-5 text-sm leading-relaxed text-muted-foreground"></p>

      <div data-modal-tech-wrap class="mt-5">
        <h4 class="mb-2 text-xs font-medium uppercase tracking-wider text-muted-foreground">Technologies</h4>
        <p data-modal-tech class="text-sm leading-relaxed text-muted-foreground"></p>
      </div>

      <a
        data-modal-link
        target="_blank"
        rel="noopener noreferrer"
        hidden
        class="mt-6 inline-flex h-9 items-center justify-center gap-2 rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground shadow transition-colors hover:bg-primary/90"
      >
        <span data-modal-link-label>View on Google Play</span>
        <Icon name="lucide:external-link" class="h-4 w-4" />
      </a>
    </div>
  </div>
</div>

<script>
  // Progressive disclosure of the project grid.
  const grid = document.querySelector<HTMLElement>('[data-projects-grid]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-projects-toggle]');
  if (grid && toggle) {
    const label = toggle.querySelector<HTMLElement>('[data-toggle-label]');
    const icon = toggle.querySelector<HTMLElement>('[data-toggle-icon]');
    const cards = [...grid.querySelectorAll<HTMLElement>('[data-project-card]')];
    const hiddenCards = cards.filter((c) => c.hidden);
    toggle.addEventListener('click', () => {
      const expanded = toggle.dataset.expanded === 'true';
      hiddenCards.forEach((c) => (c.hidden = expanded));
      toggle.dataset.expanded = String(!expanded);
      if (label) label.textContent = expanded ? `Show all ${cards.length} projects` : 'Show fewer';
      icon?.classList.toggle('rotate-180', !expanded);
    });
  }

  // Icon fallbacks for remote artwork that no longer resolves.
  document.querySelectorAll<HTMLImageElement>('img[data-fallback]').forEach((img) => {
    img.addEventListener(
      'error',
      () => {
        const fallback = img.dataset.fallback;
        if (fallback && img.src !== fallback) img.src = fallback;
      },
      { once: true }
    );
  });

  const modal = document.getElementById('project-modal');
  if (modal) {
    const panel = modal.querySelector('[data-modal-panel]') as HTMLElement;
    const nameEl = modal.querySelector('[data-modal-name]') as HTMLElement;
    const catEl = modal.querySelector('[data-modal-category]') as HTMLElement;
    const descEl = modal.querySelector('[data-modal-description]') as HTMLElement;
    const techWrap = modal.querySelector('[data-modal-tech-wrap]') as HTMLElement;
    const techEl = modal.querySelector('[data-modal-tech]') as HTMLElement;
    const imgEl = modal.querySelector('[data-modal-image]') as HTMLImageElement;
    const linkEl = modal.querySelector('[data-modal-link]') as HTMLAnchorElement;
    const statusEl = modal.querySelector('[data-modal-status]') as HTMLElement;
    const linkLabelEl = modal.querySelector('[data-modal-link-label]') as HTMLElement;
    let lastFocused: HTMLElement | null = null;

    const close = () => {
      modal.hidden = true;
      document.body.style.overflow = '';
      lastFocused?.focus();
    };

    const open = (data: any, trigger: HTMLElement) => {
      lastFocused = trigger;
      nameEl.textContent = data.name;
      catEl.textContent = data.category ?? '';
      catEl.hidden = !data.category;
      descEl.textContent = data.description ?? '';
      imgEl.src = data.image;
      imgEl.alt = data.name;
      const techs: string[] = data.technologies ?? [];
      techWrap.hidden = techs.length === 0;
      techEl.textContent = techs.join(' · ');
      const closed = data.status === 'discontinued';
      statusEl.hidden = !closed;
      linkLabelEl.textContent = closed ? 'Learn more' : 'View on Google Play';
      const hasLink = data.link && data.link !== '#';
      linkEl.hidden = !hasLink;
      if (hasLink) linkEl.href = data.link;
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      (modal.querySelector('[data-modal-close]') as HTMLElement)?.focus();
    };

    document.querySelectorAll<HTMLElement>('[data-project]').forEach((btn) => {
      btn.addEventListener('click', () => {
        try {
          open(JSON.parse(btn.dataset.project!), btn);
        } catch {
          /* malformed entry: leave the dialog closed */
        }
      });
    });

    modal.addEventListener('click', (e) => {
      if (!panel.contains(e.target as Node)) close();
    });
    modal.querySelector('[data-modal-close]')?.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.hidden) close();
    });
  }
</script>
