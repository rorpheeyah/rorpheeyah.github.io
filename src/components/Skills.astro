---
import { skills } from '@/data';
import Section from '@/components/ui/Section.astro';

const HIGHLIGHTED = ['Kotlin', 'Java', 'Jetpack Compose', 'MVVM', 'Clean Architecture'];
const groups = Object.entries(skills.skills);
---

<Section id="skills" eyebrow="Toolkit" title={skills.title} description={skills.subtitle}>
  <dl class="border-t border-border">
    {groups.map(([label, items]) => (
      <div class="grid gap-x-10 gap-y-2 border-b border-border py-6 md:grid-cols-[minmax(0,220px)_1fr]">
        <dt class="text-sm font-medium text-foreground">{label}</dt>
        <dd class="text-sm leading-relaxed text-muted-foreground">
          {/* Each skill carries its separator as a ::after so the dot never
              orphans to a line start; the real space after every item gives the
              line a place to wrap, so a long list can no longer overflow on a
              narrow screen. */}
          {items.map((skill, i) => (
            <Fragment>
              <span
                class:list={[
                  i < items.length - 1 && "after:pl-1.5 after:text-border after:content-['·']",
                  HIGHLIGHTED.includes(skill) && 'font-medium text-foreground',
                ]}
              >{skill}</span>{' '}
            </Fragment>
          ))}
        </dd>
      </div>
    ))}
  </dl>
</Section>
