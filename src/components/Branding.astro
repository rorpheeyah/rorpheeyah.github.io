---
import { branding } from '@/data';
import CircleB from '@/assets/identity/circle-b.svg';
import SealFramed from '@/assets/identity/seal-framed.svg';
import SealOpen from '@/assets/identity/seal-open.svg';
import SealRounded from '@/assets/identity/seal-rounded.svg';

// The marks are inlined rather than referenced as <img>: they are painted with
// fill="currentColor", which an external image would not inherit.
const MARKS: Record<string, any> = {
  'circle-b': CircleB,
  'seal-framed': SealFramed,
  'seal-open': SealOpen,
  'seal-rounded': SealRounded,
};
---

<section id="branding" class="py-20 px-6">
  <div class="max-w-5xl mx-auto text-center">
    <h2 class="text-3xl md:text-4xl font-bold mb-3">{branding.title}</h2>
    <p class="text-muted-foreground mb-14">{branding.subtitle}</p>

    {/* Each mark renders at or above the minimum width stated by the kit, with
        its clear space of one eighth of the rendered width on every side. */}
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-12 mb-14 justify-items-center">
      {branding.marks.map((mark) => {
        const Mark = MARKS[mark.id];
        if (!Mark) return null;
        const clearSpace = Math.round(mark.minWidth / 8);
        return (
          <figure class="flex flex-col items-center">
            <div class="identity-mark" style={`padding: ${clearSpace}px;`}>
              <Mark
                width={mark.minWidth}
                height={mark.minWidth}
                aria-hidden="true"
                focusable="false"
              />
            </div>
            <figcaption class="mt-4">
              <span class="block font-medium text-foreground">{mark.name}</span>
              <span class="block text-sm text-muted-foreground mt-1 max-w-xs">{mark.description}</span>
            </figcaption>
          </figure>
        );
      })}
    </div>

    {branding.rights && <p class="text-xs text-muted-foreground/60">{branding.rights}</p>}
  </div>
</section>

<style>
  /* One inherited colour for the whole inline SVG: ink on the light ground,
     paper on the dark one. Never a per-component recolour. */
  .identity-mark {
    color: #1a1a18;
    display: inline-flex;
  }
  :global(.dark) .identity-mark {
    color: #f2f0ec;
  }
  .identity-mark :global(svg) {
    display: block;
    height: auto;
  }
</style>
