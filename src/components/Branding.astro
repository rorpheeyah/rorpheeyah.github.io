---
import { branding } from '@/data';
import Circle from '@/assets/identity/circle.svg';
import SealFramed from '@/assets/identity/seal-framed.svg';
import SealOpen from '@/assets/identity/seal-open.svg';
import SealRounded from '@/assets/identity/seal-rounded.svg';

// The marks are inlined rather than referenced as <img>: they are painted with
// fill="currentColor", which an external image would not inherit.
const MARKS: Record<string, any> = {
  circle: Circle,
  'seal-framed': SealFramed,
  'seal-open': SealOpen,
  'seal-rounded': SealRounded,
};
---

<section id="branding" class="py-16 px-6">
  <div class="max-w-5xl mx-auto text-center">
    <h2 class="text-3xl md:text-4xl font-bold mb-2">{branding.title}</h2>
    <p class="text-sm text-muted-foreground mb-8">{branding.subtitle}</p>

    {/* One row on desktop. Each mark holds the minimum width stated by the kit
        and carries its own clear space, which also serves as the gap. */}
    <div class="flex flex-wrap justify-center items-start mb-8">
      {branding.marks.map((mark) => {
        const Mark = MARKS[mark.id];
        if (!Mark) return null;
        const clearSpace = Math.round(mark.minWidth / 8);
        return (
          <figure class="flex flex-col items-center">
            <div class="identity-mark" style={`padding: ${clearSpace}px;`}>
              <Mark
                width={mark.minWidth}
                height={mark.minWidth}
                aria-hidden="true"
                focusable="false"
              />
            </div>
            <figcaption class="text-xs text-muted-foreground">{mark.name}</figcaption>
          </figure>
        );
      })}
    </div>

    {branding.rights && <p class="text-xs text-muted-foreground/60">{branding.rights}</p>}
  </div>
</section>

<style>
  /* One inherited colour for the whole inline SVG: ink on the light ground,
     paper on the dark one. Never a per-component recolour. */
  .identity-mark {
    color: #1a1a18;
    display: inline-flex;
  }
  :global(.dark) .identity-mark {
    color: #f2f0ec;
  }
  .identity-mark :global(svg) {
    display: block;
    height: auto;
  }
</style>
