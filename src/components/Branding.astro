---
import { branding } from '@/data';
import Section from '@/components/ui/Section.astro';
import Circle from '@/assets/identity/circle.svg';
import SealFramed from '@/assets/identity/seal-framed.svg';
import SealOpen from '@/assets/identity/seal-open.svg';
import SealRounded from '@/assets/identity/seal-rounded.svg';

// A teaser for the full identity system, which lives at /identity where the
// marks are shown at their compliant sizes. The marks are inlined rather than
// referenced as <img>: they are painted with fill="currentColor", which an
// external image would not inherit.
const MARKS: Record<string, any> = {
  circle: Circle,
  'seal-framed': SealFramed,
  'seal-open': SealOpen,
  'seal-rounded': SealRounded,
};
---

<Section
  id="branding"
  eyebrow="Identity"
  title={branding.title}
  titleHref="/identity"
  description={branding.subtitle}
>
  <div class="flex flex-col items-center sm:items-start">
    <div class="grid grid-cols-2 gap-7 sm:flex sm:flex-wrap sm:items-center sm:gap-x-12 sm:gap-y-8">
      {branding.marks.map((mark) => {
        const Mark = MARKS[mark.id];
        if (!Mark) return null;
        return (
          <span class="identity-mark flex h-[72px] w-[72px] items-center justify-center" title={mark.name}>
            <Mark width={72} height={72} aria-hidden="true" focusable="false" />
          </span>
        );
      })}
    </div>
  </div>
</Section>

<style>
  /* One inherited colour for the inline SVG: ink on the light ground, paper on
     the dark one. Never a per-component recolour. */
  .identity-mark {
    color: #1a1a18;
  }
  :global(.dark) .identity-mark {
    color: #f2f0ec;
  }
  .identity-mark :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
