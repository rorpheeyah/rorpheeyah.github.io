---
import { Icon } from 'astro-icon/components';
import SignatureCompact from '@/assets/identity/signature-compact.svg';
import Button from '@/components/ui/Button.astro';

const navItems = [
  { id: 'about', label: 'About' },
  { id: 'experience', label: 'Experience' },
  { id: 'skills', label: 'Skills' },
  { id: 'projects', label: 'Projects' },
  { id: 'contact', label: 'Contact' },
];
---

<header
  data-nav
  class="sticky top-0 z-40 w-full border-b border-border bg-background/80 backdrop-blur supports-[backdrop-filter]:bg-background/60 transition-shadow"
>
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-6">
    <a href="#hero" class="identity" aria-label="Math Rorpheeyah / ម៉ាត់រ៉ភីយ៉ះ — Home">
      <SignatureCompact width={96} height={24} aria-hidden="true" focusable="false" />
    </a>

    {/* Desktop links */}
    <nav class="hidden items-center gap-6 md:flex" aria-label="Primary">
      {navItems.map((item) => (
        <a
          href={`#${item.id}`}
          data-nav-link={item.id}
          class="relative text-sm font-medium text-muted-foreground transition-colors after:absolute after:-bottom-1 after:left-0 after:h-px after:w-0 after:bg-foreground after:transition-[width] after:duration-200 hover:text-foreground hover:after:w-full"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <Button variant="ghost" size="icon" data-theme-toggle aria-label="Toggle colour theme" class="hidden md:inline-flex">
        <Icon name="lucide:sun" class="h-4 w-4 hidden dark:block" />
        <Icon name="lucide:moon" class="h-4 w-4 block dark:hidden" />
      </Button>
      <Button size="sm" data-open-cv class="hidden md:inline-flex">View CV</Button>

      {/* Mobile menu trigger */}
      <div class="relative md:hidden">
        <button
          type="button"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Open menu"
          class="inline-flex h-11 w-11 items-center justify-center rounded-md text-foreground transition-colors hover:bg-accent focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
        >
          <Icon name="lucide:menu" class="h-5 w-5" data-menu-icon-open />
          <Icon name="lucide:x" class="h-5 w-5 hidden" data-menu-icon-close />
        </button>

        <div
          id="mobile-menu"
          hidden
          class="absolute right-0 top-full mt-2 w-56 rounded-xl border border-border bg-popover text-popover-foreground shadow-lg"
        >
          <div class="flex items-center gap-3 border-b border-border p-4">
            <img src="/images/profile.png" alt="" class="h-9 w-9 rounded-full object-cover" loading="lazy" />
            <div>
              <div class="text-sm font-semibold text-foreground">Math Rorpheeyah</div>
              <div class="text-xs text-muted-foreground">Senior Android Developer</div>
            </div>
          </div>
          <div class="p-2">
            {navItems.map((item) => (
              <a
                href={`#${item.id}`}
                data-nav-link={item.id}
                data-menu-item
                class="flex items-center rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
              >
                {item.label}
              </a>
            ))}
            <a
              href="#branding"
              data-menu-item
              class="flex items-center rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
            >
              Identity
            </a>
            <button
              type="button"
              data-open-cv
              data-menu-item
              class="flex w-full items-center rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
            >
              View CV
            </button>
            <div class="my-1 h-px bg-border"></div>
            <button
              type="button"
              data-theme-toggle
              class="flex w-full items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
            >
              <Icon name="lucide:sun" class="h-4 w-4 hidden dark:block" />
              <Icon name="lucide:moon" class="h-4 w-4 block dark:hidden" />
              <span class="hidden dark:inline">Light mode</span>
              <span class="inline dark:hidden">Dark mode</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<button
  type="button"
  data-go-top
  hidden
  aria-label="Back to top"
  class="fixed bottom-6 right-6 z-40 inline-flex h-11 w-11 items-center justify-center rounded-full border border-border bg-background/90 text-foreground shadow-sm backdrop-blur transition-colors hover:bg-accent md:hidden"
>
  <Icon name="lucide:chevron-up" class="h-5 w-5" />
</button>

<script>
  const SECTIONS = ['hero', 'about', 'experience', 'skills', 'projects', 'contact'];

  // Mobile menu
  const menu = document.getElementById('mobile-menu');
  const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const iconOpen = document.querySelector<HTMLElement>('[data-menu-icon-open]');
  const iconClose = document.querySelector<HTMLElement>('[data-menu-icon-close]');

  const setMenu = (open: boolean) => {
    if (!menu || !menuBtn) return;
    menu.hidden = !open;
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
  };

  menuBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    setMenu(menu?.hidden ?? true);
  });
  document.querySelectorAll('[data-menu-item]').forEach((el) =>
    el.addEventListener('click', () => setMenu(false))
  );
  document.addEventListener('click', (e) => {
    if (menu && !menu.hidden && !menu.contains(e.target as Node) && e.target !== menuBtn) setMenu(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.hidden) setMenu(false);
  });

  // Active-section highlighting. Position-based, not IntersectionObserver: with
  // a shrunken root band a tall section never reaches a ratio threshold, so the
  // observer callback would never fire.
  const links = [...document.querySelectorAll<HTMLElement>('[data-nav-link]')];
  const setActive = (id: string) => {
    links.forEach((link) => {
      const on = link.dataset.navLink === id;
      link.classList.toggle('text-foreground', on);
      link.classList.toggle('text-muted-foreground', !on);
      if (on) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    });
  };

  const sectionEls = SECTIONS.map((id) => document.getElementById(id)).filter(
    (el): el is HTMLElement => Boolean(el)
  );

  const updateActive = () => {
    const pos = window.scrollY + 100;
    let current = sectionEls[0]?.id;
    for (const el of sectionEls) {
      if (el.offsetTop <= pos) current = el.id;
    }
    if (current) setActive(current);
  };

  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const goTop = document.querySelector<HTMLButtonElement>('[data-go-top]');
  const onScroll = () => {
    nav?.classList.toggle('shadow-sm', window.scrollY > 8);
    if (goTop) goTop.hidden = window.scrollY <= 300;
    updateActive();
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  goTop?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
</script>

<style>
  /* One inherited colour for the inline signature lockup: ink on the light
     ground, paper on the dark one. Painted with currentColor. */
  .identity {
    display: inline-flex;
    flex: none;
    color: #1a1a18;
    padding: 3px;
  }
  :global(.dark) .identity {
    color: #f2f0ec;
  }
  .identity :global(svg) {
    display: block;
    width: 96px;
    height: 24px;
    flex: none;
  }
</style>
