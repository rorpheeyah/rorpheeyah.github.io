---
import { Icon } from 'astro-icon/components';
import { about } from '@/data';
import { iconFor } from '@/lib/icons';
---

<section id="about" class="py-20 px-6">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold mb-6">{about.title}</h2>
      <p class="text-xl text-muted-foreground max-w-4xl mx-auto leading-relaxed">
        {about.description}
      </p>
    </div>

    {about.stats?.length > 0 && (
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-16">
        {about.stats.map((stat) => (
          <div class="text-center p-6 rounded-xl bg-accent/50 backdrop-blur-sm border border-border/50">
            <Icon name={iconFor(stat.icon)} class="w-8 h-8 mx-auto mb-3 text-primary" />
            <div class="text-3xl font-bold text-primary mb-1">{stat.value}</div>
            <div class="text-sm text-muted-foreground">{stat.label}</div>
          </div>
        ))}
      </div>
    )}

    {about.achievements?.length > 0 && (
      <div class="mb-16">
        <h3 class="text-2xl font-semibold mb-8 text-center">Key Achievements</h3>
        <div class="grid md:grid-cols-3 gap-6">
          {about.achievements.map((a) => (
            <div class="p-6 rounded-xl border bg-background border-border/50">
              <Icon
                name={iconFor(a.icon)}
                class={`w-8 h-8 mb-4 ${a.highlight ? 'text-primary' : 'text-muted-foreground'}`}
              />
              <h4 class="text-lg font-semibold mb-2">{a.title}</h4>
              <p class="text-sm text-muted-foreground leading-relaxed">{a.description}</p>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</section>
