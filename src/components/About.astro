---
import { Icon } from 'astro-icon/components';
import { about } from '@/data';
import { iconFor } from '@/lib/icons';
import Section from '@/components/ui/Section.astro';
---

<Section id="about" eyebrow="Profile" title={about.title} description={about.description} bordered={false}>
  {about.stats?.length > 0 && (
    <dl class="grid grid-cols-1 divide-y divide-border border-y border-border sm:grid-cols-3 sm:divide-x sm:divide-y-0">
      {about.stats.map((stat) => (
        <div class="py-6 sm:px-8 sm:first:pl-0 sm:last:pr-0">
          <dt class="text-4xl font-semibold tracking-tight text-foreground">{stat.value}</dt>
          <dd class="mt-1 text-sm text-muted-foreground">{stat.label}</dd>
        </div>
      ))}
    </dl>
  )}

  {about.achievements?.length > 0 && (
    <div class="mt-16">
      <h3 class="mb-8 text-xs font-medium uppercase tracking-widest text-muted-foreground">Highlights</h3>
      <div class="grid gap-x-10 gap-y-10 md:grid-cols-3">
        {about.achievements.map((a) => (
          <div>
            <Icon name={iconFor(a.icon)} class:list={['h-5 w-5', a.highlight ? 'text-foreground' : 'text-muted-foreground']} />
            <h4 class="mt-4 font-semibold text-foreground">{a.title}</h4>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{a.description}</p>
          </div>
        ))}
      </div>
    </div>
  )}
</Section>
