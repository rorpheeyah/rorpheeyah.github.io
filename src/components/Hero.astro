---
import { Icon } from 'astro-icon/components';
import { hero } from '@/data';
import { iconFor } from '@/lib/icons';
---

<section id="hero" class="min-h-screen flex items-center justify-center px-6">
  <div class="w-full max-w-4xl mx-auto text-center space-y-12">
    <div class="space-y-8">
      <h1 class="text-5xl md:text-6xl lg:text-7xl font-light tracking-tight text-foreground">
        {hero.name}
      </h1>

      {/* Titles rotate via CSS; the first is in the markup for crawlers and no-JS. */}
      <div class="h-12 flex items-center justify-center">
        <h2 class="text-xl md:text-2xl font-normal tracking-wide text-muted-foreground" data-rotating-title>
          {hero.titles[0]}
        </h2>
      </div>

      <p class="text-lg md:text-xl text-muted-foreground max-w-2xl mx-auto leading-relaxed font-light">
        {hero.description}
      </p>
    </div>

    <div class="pt-4">
      <button
        type="button"
        data-open-cv
        class="inline-flex items-center justify-center px-8 py-4 rounded-lg bg-primary text-primary-foreground font-semibold text-base hover:bg-primary/90 transition-all duration-200"
      >
        View CV
      </button>
    </div>

    {hero.socialLinks?.length > 0 && (
      <div class="flex items-center justify-center gap-8 pt-8">
        {hero.socialLinks.slice(0, 3).map((social) => (
          <a
            href={social.href}
            target={social.external ? '_blank' : undefined}
            rel={social.external ? 'noopener noreferrer' : undefined}
            class="text-muted-foreground hover:text-foreground transition-colors duration-300"
            aria-label={social.label}
          >
            <Icon name={iconFor(social.icon)} class="w-6 h-6" />
          </a>
        ))}
      </div>
    )}
  </div>

  <div class="absolute bottom-12 left-1/2 -translate-x-1/2 hidden md:block">
    <a
      href="#about"
      class="text-muted-foreground/60 hover:text-muted-foreground transition-colors duration-300 block"
      aria-label="Scroll to learn more"
    >
      <Icon name="lucide:arrow-down" class="w-5 h-5 animate-bounce" />
    </a>
  </div>
</section>

<script is:inline define:vars={{ titles: hero.titles }}>
  const el = document.querySelector('[data-rotating-title]');
  if (el && titles.length > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let i = 0;
    el.style.transition = 'opacity 300ms';
    setInterval(() => {
      el.style.opacity = '0';
      setTimeout(() => {
        i = (i + 1) % titles.length;
        el.textContent = titles[i];
        el.style.opacity = '1';
      }, 300);
    }, 3000);
  }
</script>
