---
import { experience } from '@/data';
import Section from '@/components/ui/Section.astro';
import Badge from '@/components/ui/Badge.astro';
---

<Section id="experience" eyebrow="Career" title={experience.title} description={experience.subtitle}>
  <div class="relative">
    {/* One continuous rule; dots sit on it. */}
    <span aria-hidden="true" class="absolute bottom-2 left-[5px] top-2 w-px bg-border"></span>

    <div class="space-y-12">
      {experience.experiences.map((exp) => (
        <div class="relative pl-8 md:pl-10">
          <span class="absolute left-0 top-1.5 h-2.5 w-2.5 rounded-full border-2 border-background bg-foreground"></span>

          <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
            <img
              class="h-6 w-6 flex-none rounded-md border border-border bg-white object-contain p-1"
              src={`/images/logos/${exp.logo}.png`}
              alt={`${exp.company} logo`}
              loading="lazy"
              decoding="async"
            />
            <h3 class="text-lg font-semibold leading-tight text-foreground">{exp.title}</h3>
          </div>

          <p class="mt-1 text-sm font-medium text-foreground">{exp.company}</p>
          <div class="mt-1 flex flex-col gap-y-1 text-sm text-muted-foreground sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-2">
            <span>{exp.period}</span>
            <span aria-hidden="true" class="hidden text-border sm:inline">&middot;</span>
            <span>{exp.location}</span>
            <Badge variant="secondary" class="w-fit sm:ml-1">{exp.type}</Badge>
          </div>

          <p class="mt-4 max-w-3xl text-sm leading-relaxed text-muted-foreground">{exp.description}</p>

          <p class="mt-4 max-w-3xl text-sm leading-relaxed text-muted-foreground">
            {exp.technologies.join(' · ')}
          </p>
        </div>
      ))}
    </div>
  </div>
</Section>
