---
import { Icon } from 'astro-icon/components';
import { contact } from '@/data';
import { iconFor } from '@/lib/icons';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';

const s = (contact.status || '').toLowerCase();
const available = s.includes('available') || s.includes('open');
const year = new Date().getFullYear();
---

<Section id="contact" eyebrow="Contact" title={contact.title} description={contact.subtitle}>
  <div class="mb-10 flex flex-wrap items-center gap-x-4 gap-y-2">
    <span class="inline-flex items-center gap-2 rounded-md border border-border px-2.5 py-1 text-xs font-medium text-muted-foreground">
      <span class:list={['h-2 w-2 rounded-full', available ? 'bg-green-500' : 'bg-muted-foreground']}></span>
      {contact.status}
    </span>
  </div>

  <div class="grid border-t border-border sm:grid-cols-2">
    {contact.social.map((item) => {
      const external = item.url.startsWith('http');
      return (
        <a
          href={item.url}
          target={external ? '_blank' : undefined}
          rel={external ? 'noopener noreferrer' : undefined}
          class="group flex items-center gap-4 border-b border-border py-4 transition-colors sm:odd:border-r sm:odd:pr-8 sm:even:pl-8"
        >
          <Icon name={iconFor(item.icon)} class="h-5 w-5 flex-none text-muted-foreground transition-colors group-hover:text-foreground" />
          <div class="min-w-0 flex-1">
            <div class="text-sm font-medium text-foreground">{item.name}</div>
            <div class="truncate text-xs text-muted-foreground">{item.value}</div>
          </div>
          <Icon name="lucide:arrow-up-right" class="h-4 w-4 flex-none text-muted-foreground opacity-0 transition-opacity group-hover:opacity-100" />
        </a>
      );
    })}
  </div>
</Section>

<footer class="border-t border-border">
  <div class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-4 px-6 py-8 sm:flex-row">
    <p class="text-sm text-muted-foreground">&copy; {year} Math Rorpheeyah</p>
    <Button variant="ghost" size="sm" href="/cv">
      View CV
      <Icon name="lucide:arrow-right" class="h-3.5 w-3.5" />
    </Button>
  </div>
</footer>
