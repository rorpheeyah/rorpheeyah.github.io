---
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Math Rorpheeyah - Senior Android Developer Portfolio',
  description = 'Senior Android Developer with more than six years building enterprise mobile apps across fintech, secure SDK integration, and modern Android architecture.',
} = Astro.props;

const ogImage = new URL('/images/og-image.png', Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// schema.org Person structured data (for search engines / rich results).
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Math Rorpheeyah',
  alternateName: 'ម៉ាត់រ៉ភីយ៉ះ',
  jobTitle: 'Senior Android Developer',
  gender: 'Female',
  url: Astro.site?.href ?? 'https://rorpheeyah.github.io',
  image: ogImage,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Phnom Penh',
    addressCountry: 'KH',
  },
  sameAs: ['https://github.com/rorpheeyah', 'https://linkedin.com/in/rorpheeyah'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Math Rorpheeyah" />
    <meta
      name="keywords"
      content="Android Developer, Mobile Developer, Kotlin, Java, Senior Developer, Enterprise Apps, KOSIGN, Cambodia Developer"
    />
    <link rel="canonical" href={canonical} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} is:inline />


    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Portrait of Math Rorpheeyah beside the bilingual signature, Senior Android Developer title, and portfolio address." />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Portrait of Math Rorpheeyah beside the bilingual signature, Senior Android Developer title, and portfolio address." />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:ital,wght@0,400;0,500;1,400;1,500&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/images/icons/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/icons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/icons/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/icons/apple-touch-icon.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />

    {/* Applies the stored theme before first paint, so the page does not flash. */}
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('app-theme');
          const dark = saved
            ? saved === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', dark);
        } catch {
          /* private mode or blocked storage: fall through to the light default */
        }
      })();
    </script>

    {/* Enable scroll-reveal only when we can animate it well. Set before first
        paint so sections start hidden without a flash; skipped for reduced
        motion or missing IntersectionObserver, leaving all content visible. */}
    <script is:inline>
      try {
        if (
          'IntersectionObserver' in window &&
          !window.matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
          document.documentElement.classList.add('reveal-on');
        }
      } catch {
        /* leave content visible */
      }
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-lg focus:bg-background focus:px-4 focus:py-2 focus:ring-2 focus:ring-primary"
    >
      Skip to content
    </a>
    <slot />

    <script>
      // Theme toggling. Buttons opt in with [data-theme-toggle].
      const root = document.documentElement;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

      const setTheme = (dark: boolean) => {
        root.classList.toggle('dark', dark);
        try {
          localStorage.setItem('app-theme', dark ? 'dark' : 'light');
        } catch {
          /* ignore unavailable storage */
        }
        document
          .querySelectorAll<HTMLElement>('[data-theme-toggle]')
          .forEach((el) => el.setAttribute('aria-pressed', String(dark)));
      };

      // Quick crossfade between page snapshots, via the View Transitions API
      // (styled in global.css). Falls back to an instant swap without it or when
      // motion is reduced.
      const startViewTransition = (document as any).startViewTransition?.bind(document);
      const apply = (dark: boolean) => {
        if (!startViewTransition || reduce.matches) {
          setTheme(dark);
          return;
        }
        startViewTransition(() => setTheme(dark));
      };

      document.querySelectorAll<HTMLElement>('[data-theme-toggle]').forEach((el) => {
        el.setAttribute('aria-pressed', String(root.classList.contains('dark')));
        el.addEventListener('click', () => apply(!root.classList.contains('dark')));
      });

      // Follow the system setting only while the visitor has made no explicit choice.
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
        let saved: string | null = null;
        try {
          saved = localStorage.getItem('app-theme');
        } catch {
          /* ignore */
        }
        if (!saved) setTheme(e.matches);
      });
    </script>

    <script>
      // Scroll reveal: reveal each section once as it enters the viewport. The
      // .reveal-on class (set in <head> before paint) gates the hidden state, so
      // this only runs where the reveal is enabled.
      if (document.documentElement.classList.contains('reveal-on')) {
        const sections = document.querySelectorAll<HTMLElement>('#main > section:not(#hero)');
        const io = new IntersectionObserver(
          (entries, obs) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                obs.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.05 }
        );
        sections.forEach((s) => io.observe(s));
      }
    </script>
  </body>
</html>
