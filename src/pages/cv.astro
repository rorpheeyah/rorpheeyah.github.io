---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import profileImg from '@/assets/profile.png';
import SignatureCompact from '@/assets/identity/signature-compact.svg';
import Base from '@/layouts/Base.astro';
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import GridField from '@/components/GridField.astro';
import { cv } from '@/data';
import { iconFor } from '@/lib/icons';
---

<Base
  title="Curriculum Vitae — Math Rorpheeyah"
  description="Curriculum vitae of Math Rorpheeyah — Senior Android Developer: experience, technical skills, education, and languages."
>
  <header class="sticky top-0 z-40 border-b border-border bg-background/90 backdrop-blur supports-[backdrop-filter]:bg-background/60">
    <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-6">
      <a href="/" class="identity" aria-label="Math Rorpheeyah / ម៉ាត់រ៉ភីយ៉ះ — Home">
        <SignatureCompact width={96} height={24} aria-hidden="true" focusable="false" />
      </a>

      <div class="flex items-center gap-2">
        <Button variant="ghost" size="icon" data-theme-toggle aria-label="Toggle colour theme">
          <Icon name="lucide:sun" class="h-4 w-4 hidden dark:block" />
          <Icon name="lucide:moon" class="h-4 w-4 block dark:hidden" />
        </Button>
        <Button
          variant="outline"
          size="sm"
          href={cv.downloads?.cv?.path ?? '/cv.pdf'}
          download={cv.downloads?.cv?.filename ?? 'Math_Rorpheeyah_CV.pdf'}
        >
          <Icon name="lucide:download" class="h-4 w-4" />
          <span class="hidden sm:inline">Download PDF</span>
          <span class="sm:hidden">PDF</span>
        </Button>
      </div>
    </div>
  </header>

  <main>
    <section class="relative overflow-hidden border-b border-border">
      <GridField />
      <div class="mx-auto max-w-5xl px-6 py-14 md:py-16">
        <div class="mb-8 flex items-center gap-3">
          <span class="h-px w-6 bg-border"></span>
          <span class="font-mono text-xs uppercase tracking-widest text-muted-foreground">Curriculum Vitae</span>
        </div>

        <div class="grid grid-cols-1 gap-8 lg:grid-cols-3 lg:gap-10">
          <div class="lg:col-span-2 flex flex-col items-center gap-6 text-center sm:flex-row sm:items-start sm:text-left">
            {cv.personal?.profileImage && (
              <Image
                src={profileImg}
                alt=""
                width={96}
                height={96}
                class="h-24 w-24 flex-none rounded-2xl border border-border object-cover shadow-sm"
                loading="eager"
              />
            )}
            <div>
              <div class="mb-3 inline-flex items-center gap-2 rounded-full border border-border bg-background/60 px-3 py-1 text-xs font-medium text-muted-foreground">
                <span class="relative flex h-2 w-2">
                  <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-500 opacity-75"></span>
                  <span class="relative inline-flex h-2 w-2 rounded-full bg-green-500"></span>
                </span>
                {cv.personal?.availability ?? 'Available for opportunities'}
              </div>
              <h1 class="text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">{cv.personal?.name}</h1>
              <p class="mt-1 text-lg text-muted-foreground">{cv.personal?.title}</p>
              <p class="mt-1 text-sm text-muted-foreground">{cv.personal?.location}</p>
              <div class="mt-4 flex flex-col items-center gap-2 sm:flex-row sm:flex-wrap sm:justify-start sm:gap-x-4">
                {cv.contacts?.map((c) => (
                  <a
                    href={c.href}
                    class="inline-flex items-center gap-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground"
                  >
                    <Icon name={iconFor(c.icon)} class="h-4 w-4" />
                    {c.value}
                  </a>
                ))}
                {cv.personal?.website && (
                  <a
                    href={`https://${cv.personal.website}`}
                    class="inline-flex items-center gap-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground"
                  >
                    <Icon name="lucide:globe" class="h-4 w-4" />
                    {cv.personal.website}
                  </a>
                )}
              </div>
            </div>
          </div>

          {cv.highlights?.length > 0 && (
            <Card class="p-6 shadow-sm">
              <h2 class="mb-4 flex items-center gap-2 text-sm font-semibold text-foreground">
                <Icon name="lucide:trophy" class="h-4 w-4 text-muted-foreground" />
                Highlights
              </h2>
              <ul class="space-y-2.5">
                {cv.highlights.map((h) => (
                  <li class="flex items-start gap-2.5 text-sm text-muted-foreground">
                    <Icon name={iconFor(h.icon)} class="mt-0.5 h-4 w-4 flex-none text-muted-foreground" />
                    <span>{h.text}</span>
                  </li>
                ))}
              </ul>
            </Card>
          )}
        </div>
      </div>
    </section>

    <div class="mx-auto max-w-5xl px-6 py-12">
      <section>
        <h2 class="mb-5 border-b border-border pb-2 text-xl font-semibold text-foreground">Professional summary</h2>
        <p class="max-w-3xl leading-relaxed text-muted-foreground">{cv.summary}</p>
      </section>

    <section class="mt-14">
      <h2 class="mb-6 border-b border-border pb-2 text-xl font-semibold text-foreground">Work experience</h2>
      <div class="divide-y divide-border">
        {cv.experiences.map((exp) => (
          <div class="py-6 first:pt-6">
            <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
              <div>
                <h3 class="font-semibold text-foreground">{exp.title}</h3>
                <p class="mt-1 text-sm text-muted-foreground">{exp.company}</p>
                <p class="mt-1 text-sm text-muted-foreground">{exp.period} · {exp.location}</p>
              </div>
              <Badge variant="secondary" class="w-fit flex-none">{exp.type}</Badge>
            </div>
            <ul class="mt-4 space-y-2 text-sm text-muted-foreground">
              {exp.achievements.map((a) => (
                <li class="flex items-start gap-2.5">
                  <span class="mt-2 h-1 w-1 flex-none rounded-full bg-muted-foreground"></span>
                  <span class="leading-relaxed">{a}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-14">
      <h2 class="mb-6 border-b border-border pb-2 text-xl font-semibold text-foreground">Technical skills</h2>
      <div class="grid gap-6 sm:grid-cols-2">
        {Object.entries(cv.skills).map(([category, list]) => (
          <div>
            <h3 class="mb-2 text-sm font-semibold text-foreground">{category}</h3>
            <p class="text-sm leading-relaxed text-muted-foreground">{list.join(' · ')}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-14 grid grid-cols-1 gap-10 lg:grid-cols-2">
      <div>
        <h2 class="mb-6 border-b border-border pb-2 text-xl font-semibold text-foreground">Education</h2>
        <div class="divide-y divide-border">
          {cv.education.map((edu) => (
            <div class="py-5">
              <h3 class="font-semibold text-foreground">{edu.degree}</h3>
              <p class="mt-1 text-sm text-muted-foreground">{edu.institution}</p>
              <p class="mt-1 text-sm text-muted-foreground">{edu.period}</p>
              {edu.details && <p class="mt-2 text-sm text-muted-foreground">{edu.details}</p>}
            </div>
          ))}
        </div>
      </div>

      <div>
        <h2 class="mb-6 border-b border-border pb-2 text-xl font-semibold text-foreground">Languages</h2>
        <div class="divide-y divide-border">
          {cv.languages.map((lang) => (
            <div class="flex items-center justify-between py-3">
              <span class="text-sm font-medium text-foreground">{lang.name}</span>
              <span class="text-sm text-muted-foreground">{lang.level}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

      <div class="mt-14 border-t border-border pt-8">
        <a href="/" class="group inline-flex items-center gap-2 text-sm font-medium text-foreground">
          <Icon name="lucide:arrow-left" class="h-4 w-4 transition-transform group-hover:-translate-x-0.5" />
          Back to portfolio
        </a>
      </div>
    </div>
  </main>
</Base>

<style>
  /* The header signature is an inline currentColor SVG: ink on light, paper on dark. */
  .identity {
    color: #1a1a18;
  }
  :global(.dark) .identity {
    color: #f2f0ec;
  }
  .identity :global(svg) {
    display: block;
  }
</style>
